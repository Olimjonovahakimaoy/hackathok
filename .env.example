# AI yordamchi uchun Anthropic API kaliti (https://console.anthropic.com). Bo'sh bo'lsa AI o'chiq turadi.
ANTHROPIC_API_KEY=
# Ixtiyoriy: model nomi
AI_MODEL=claude-haiku-5-5

# Maktab nomi (interfeysda ko'rinadi)
SCHOOL_NAME="SmartSchool 1-maktab"
